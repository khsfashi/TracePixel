{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tracepixel:schema:palette-light-stage:v1",
  "title": "TracePixel Palette / Light Ramp Stage v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "stage",
    "palette",
    "ramps",
    "program"
  ],
  "properties": {
    "schema": {
      "const": "tracepixel.palette-light-stage.v1"
    },
    "stage": {
      "const": "palette_light_ramp"
    },
    "palette": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/paletteColor"
      }
    },
    "ramps": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/lightRamp"
      }
    },
    "program": {
      "$ref": "pixel-program.v1.schema.json"
    }
  },
  "$defs": {
    "paletteColor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "rgba"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        },
        "rgba": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },
    "lightRamp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "colors"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        },
        "colors": {
          "type": "array",
          "minItems": 2,
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          }
        }
      }
    }
  }
}
