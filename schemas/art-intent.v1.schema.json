{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tracepixel:schema:art-intent:v1",
  "title": "TracePixel ArtIntent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "asset_class",
    "canvas",
    "composition"
  ],
  "properties": {
    "schema": {
      "const": "tracepixel.art-intent.v1"
    },
    "asset_class": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "canvas": {
      "$ref": "#/$defs/canvas"
    },
    "composition": {
      "$ref": "#/$defs/composition"
    }
  },
  "$defs": {
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      }
    },
    "occupiedBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "symmetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis",
        "strength"
      ],
      "properties": {
        "axis": {
          "enum": [
            "vertical",
            "horizontal",
            "both"
          ]
        },
        "strength": {
          "enum": [
            "hint",
            "required"
          ]
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occupied_bounds",
        "facing",
        "symmetry",
        "light_direction",
        "palette_budget"
      ],
      "properties": {
        "occupied_bounds": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/occupiedBounds"
            }
          ]
        },
        "facing": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "left",
            "right",
            "up",
            "down",
            "front",
            "back"
          ]
        },
        "symmetry": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/symmetry"
            }
          ]
        },
        "light_direction": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "top",
            "top_right",
            "right",
            "bottom_right",
            "bottom",
            "bottom_left",
            "left",
            "top_left"
          ]
        },
        "palette_budget": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 256
        }
      }
    }
  }
}
