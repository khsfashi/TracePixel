{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tracepixel:schema:feedback-localization:v1",
  "title": "TracePixel P7-F1 Feedback Localization v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "intake", "localizations"],
  "properties": {
    "schema": {"const": "tracepixel.feedback-localization.v1"},
    "intake": {"$ref": "urn:tracepixel:schema:feedback-intake:v1"},
    "localizations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/localization"}
    }
  },
  "$defs": {
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feedback_id",
        "affected_stages",
        "affected_region",
        "stage_basis",
        "region_basis"
      ],
      "properties": {
        "feedback_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "affected_stages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "silhouette",
              "major_forms",
              "palette_light_ramp",
              "shading",
              "semantic_details",
              "outline_cleanup"
            ]
          }
        },
        "affected_region": {"$ref": "#/$defs/region"},
        "stage_basis": {
          "enum": ["source_hint", "full_pipeline_fallback"]
        },
        "region_basis": {
          "enum": ["source_hint", "full_canvas_fallback"]
        }
      }
    }
  }
}
