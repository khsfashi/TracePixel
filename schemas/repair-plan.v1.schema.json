{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tracepixel:schema:repair-plan:v1",
  "title": "TracePixel P7-F2 Minimal Repair Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "localization", "repairs"],
  "properties": {
    "schema": {"const": "tracepixel.repair-plan.v1"},
    "localization": {"$ref": "urn:tracepixel:schema:feedback-localization:v1"},
    "repairs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/repair"}
    }
  },
  "$defs": {
    "stage": {
      "enum": [
        "silhouette",
        "major_forms",
        "palette_light_ramp",
        "shading",
        "semantic_details",
        "outline_cleanup"
      ]
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feedback_id",
        "disposition",
        "target_stage",
        "planned_region",
        "repair_program",
        "planned_operation_count",
        "planned_pixel_edit_count",
        "defer_reason"
      ],
      "properties": {
        "feedback_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "disposition": {"enum": ["repair", "defer"]},
        "target_stage": {
          "oneOf": [
            {"$ref": "#/$defs/stage"},
            {"type": "null"}
          ]
        },
        "planned_region": {
          "oneOf": [
            {"$ref": "#/$defs/region"},
            {"type": "null"}
          ]
        },
        "repair_program": {
          "oneOf": [
            {"$ref": "urn:tracepixel:schema:pixel-program:v1"},
            {"type": "null"}
          ]
        },
        "planned_operation_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "planned_pixel_edit_count": {"type": "integer", "minimum": 0},
        "defer_reason": {
          "oneOf": [
            {"type": "string", "minLength": 1, "maxLength": 256},
            {"type": "null"}
          ]
        }
      }
    }
  }
}
