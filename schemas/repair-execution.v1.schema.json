{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tracepixel:schema:repair-execution:v1",
  "title": "TracePixel P7-F3 Repair Execution and Re-QA v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan",
    "source_rgba_sha256",
    "result_rgba_sha256",
    "executions",
    "applied_operation_count",
    "applied_pixel_edit_count",
    "observed_changed_pixel_count",
    "unaffected_region_stable",
    "qa"
  ],
  "properties": {
    "schema": {
      "const": "tracepixel.repair-execution.v1"
    },
    "plan": {
      "$ref": "urn:tracepixel:schema:repair-plan:v1"
    },
    "source_rgba_sha256": {
      "$ref": "#/$defs/digest"
    },
    "result_rgba_sha256": {
      "$ref": "#/$defs/digest"
    },
    "executions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/execution"
      }
    },
    "applied_operation_count": {
      "type": "integer",
      "minimum": 0
    },
    "applied_pixel_edit_count": {
      "type": "integer",
      "minimum": 0
    },
    "observed_changed_pixel_count": {
      "type": "integer",
      "minimum": 0
    },
    "unaffected_region_stable": {
      "type": "boolean"
    },
    "qa": {
      "$ref": "https://tracepixel.dev/schemas/qa-findings.v1.schema.json"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stage": {
      "enum": [
        "silhouette",
        "major_forms",
        "palette_light_ramp",
        "shading",
        "semantic_details",
        "outline_cleanup"
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feedback_id",
        "status",
        "target_stage",
        "applied_operation_count",
        "applied_pixel_edit_count",
        "observed_changed_pixel_count"
      ],
      "properties": {
        "feedback_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "enum": [
            "applied",
            "deferred"
          ]
        },
        "target_stage": {
          "oneOf": [
            {
              "$ref": "#/$defs/stage"
            },
            {
              "type": "null"
            }
          ]
        },
        "applied_operation_count": {
          "type": "integer",
          "minimum": 0
        },
        "applied_pixel_edit_count": {
          "type": "integer",
          "minimum": 0
        },
        "observed_changed_pixel_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
